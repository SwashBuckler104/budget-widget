<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SCOPE.md F3/F6. Runtime permission on Android 13+; asked for in Settings. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Notification action buttons. Only our own PendingIntents reach it. -->
        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="false" />

        <!-- Day alarms (our own PendingIntents) plus system clock/time-zone changes and our own
             updates, which the system delivers to non-exported receivers too. -->
        <receiver
            android:name=".day.DayTickReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
